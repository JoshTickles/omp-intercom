{
  "name": "omp-intercom",
  "version": "0.2.0-straker.1",
  "description": "Direct 1:1 messaging between omp sessions on the same machine, with automatic enrolment and peer awareness (Straker fork)",
  "license": "MIT",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "types.ts",
    "config.ts",
    "cwd.ts",
    "extension-api.ts",
    "format-context.ts",
    "reply-tracker.ts",
    "peer-identity.ts",
    "peer-match.ts",
    "roster.ts",
    "broker/**/*.ts",
    "ui/**/*.ts",
    "skills/**/*",
    "CHANGELOG.md",
    "banner.png"
  ],
  "scripts": {
    "test": "bun test broker/client.test.ts broker/client-liveness.test.ts broker/extension.test.ts broker/framing.test.ts broker/paths.test.ts broker/runtime-claim.test.ts broker/spawn.test.ts config.test.ts cwd.test.ts format-context.test.ts reply-tracker.test.ts intercom.integration.test.ts test/inline-message.test.ts test/overlay-width.test.ts peer-identity.test.ts peer-match.test.ts peer-awareness.integration.test.ts"
  },
  "keywords": [
    "omp-package",
    "pi-package",
    "omp",
    "extension",
    "intercom",
    "messaging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshTickles/omp-intercom.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": { "optional": true },
    "@oh-my-pi/pi-coding-agent": { "optional": true },
    "@oh-my-pi/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "dependencies": {
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "typebox": "*"
  }
}
